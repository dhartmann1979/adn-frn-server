  },
  {
   "to": "en",
   "re": "^Backup-Datei \\(\\.tar\\.gz oder \\.tar\\.gz\\.age, maximal (.+)\\)$",
   "flags": "",
   "rep": "Backup file (.tar.gz or .tar.gz.age, at most $1)"
  },
  {
   "to": "en",
   "re": "^Backup erstellt \\((.+)\\)\\. Download wird gestartet\\.$",
   "flags": "",
