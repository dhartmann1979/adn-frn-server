[Unit]
Description=frn_adn – dashboard and admin portal for the FRN server (Auf der NachtSchicht)
After=network-online.target frn-server.service
Wants=network-online.target

[Service]
Type=simple
User=frnadn
Group=frnadn
WorkingDirectory=/opt/frnadn
Environment=FRNADN_DATA=/var/lib/frnadn
Environment=FRNADN_FRN_HOME=/var/lib/frnadn/frn
Environment=FRNADN_FRN_JAR=/opt/frn-server/FRN_Server.jar
Environment=FRNADN_PORT=80
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/frnadn/venv/bin/python -m frnadn
# web port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# the admin portal restarts the dashboard by exiting; systemd starts it again
Restart=always
RestartSec=2
TimeoutStopSec=15
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
